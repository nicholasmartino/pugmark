{
    "cSpell.words": [
        "accesstoken",
        "artifactregistry",
        "dotenv",
        "hostedtoolcache",
        "iamcredentials",
        "pugmark",
        "secretmanager"
    ],
    "python.terminal.executeInFileDir": false,
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.terminal.launchArgs": [
        "-c",
        "import sys; sys.path.append('${workspaceFolder}')"
    ]
}